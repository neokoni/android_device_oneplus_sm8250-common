cc_library_shared {
    name: "liboplusvibratoreffect.oplus_kona",
    vendor: true,
    srcs: [
        "effect.cpp",
        "VibrationEffectLoader.cpp"
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "libjsoncpp",
        "libutils",
    ],
    include_dirs: select(soong_config_variable("OPLUS_LINEAGE_VIBRATOR_HAL", "INCLUDE_DIR"), {
        any @ flag_val: [flag_val],
        default: [],
    }),
}
